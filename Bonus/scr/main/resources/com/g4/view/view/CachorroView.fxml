<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seuprojeto.controller.CachorroController">
    <children>
        <TableView fx:id="cachorroTable" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="nomeColumn" text="Nome" />
                <TableColumn fx:id="racaColumn" text="Raça" />
                <TableColumn fx:id="donoColumn" text="Dono" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <GridPane hgap="10.0" vgap="10.0" style="-fx-padding: 10;">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nomeField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Raça:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="racaField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Dono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="donoField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <HBox spacing="10.0" style="-fx-padding: 10;">
            <children>
                <Button fx:id="salvarButton" onAction="#handleSalvarCachorro" text="Salvar" />
            </children>
        </HBox>
    </children>
</VBox>
